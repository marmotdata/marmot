      "sql": {
        "_producer": "https://github.com/ilum-cloud/duck_lineage",
        "_schemaURL": "https://openlineage.io/spec/job/sql/1-0-0.json",
        "query": "CREATE TABLE main.revenue_by_region AS SELECT c.region, r.label, sum(o.total) AS revenue, count(*) AS orders FROM main.orders o JOIN main.customers c ON o.customer_id = c.id JOIN main.regions r ON r.region = c.region GROUP BY ALL;"
      }
    },
