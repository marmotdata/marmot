{
	"name": "marmot",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"i18n:check": "node scripts/check-i18n.mjs",
		"check": "svelte-kit sync && pnpm run i18n:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && pnpm run i18n:compile && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
